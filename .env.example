# Copy to .env and fill in. Never commit .env.
# Values below work with docker compose as-is, except the API keys.

# ---- Infrastructure ----
DATABASE_URL=postgresql+psycopg://firstweek:firstweek@localhost:5432/firstweek
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=firstweek-main

# ---- Model providers (pay per use: set a monthly limit in each console) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free key for the claim verifier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional second free source, used when Gemini's daily quota is gone: https://console.groq.com
GROQ_API_KEY=

# ---- Model routing (LiteLLM model strings) ----
MODEL_FRONTIER=anthropic/claude-opus-5-5
MODEL_MID=anthropic/claude-sonnet-5-5
MODEL_SMALL=anthropic/claude-haiku-5-5
# The judge must come from a different model family than the generator.
MODEL_JUDGE=gemini/gemini-3.6-flash
# Free local model (downloaded once, ~65 MB). Changing it needs a migration: vectors are 384 wide.
MODEL_EMBEDDING=local/BAAI/bge-small-en-v1.5
# Where local models are kept (the Docker worker uses its own volume).
MODEL_CACHE_DIR=~/.cache/firstweek/models

# ---- Budgets ----
# Default spend cap for one budget scope (one research run, one simulation...).
DEFAULT_BUDGET_USD=2.00

# Daily research run (collect + classify + extract + statistics for each golden role).
# The worker creates the schedule; if the last collection is over 20 hours old when it
# starts, it also runs once straight away. Set to false to switch it off.
RESEARCH_DAILY_ENABLED=true
RESEARCH_DAILY_CRON=17 7 * * *
RESEARCH_DAILY_TIMEZONE=Europe/London
RESEARCH_BUDGET_USD_PER_ROLE=1.00

# ---- Tracing (Langfuse Cloud, free Hobby plan) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region; use https://us.cloud.langfuse.com for the US region
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- Research sources (used from M1) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FIRECRAWL_API_KEY=

# ---- Sandbox ----
# docker (default, your machine) or e2b (hosted: needs E2B_API_KEY, https://e2b.dev)
SANDBOX_BACKEND=docker
E2B_API_KEY=

# ---- Deployment (see docs/deploy.md) ----
# Shared by the web app and the API so the API can count rate limits per visitor.
INTERNAL_API_KEY=
# The API seeds the hand-written demo project for this role on every start (optional).
SEED_DEMO_ROLE=

# Free model on your own machine (Ollama): no daily limit, no key, no cost. Tried first when set.
# MODEL_LOCAL=ollama/qwen2.5-coder:7b
